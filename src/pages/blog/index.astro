---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Blog" description="Articles, notes, and things I'm figuring out.">
  <section class="section wrap">
    <span class="label reveal">Writing</span>
    <h1 class="page-title reveal gradient-text">Blog</h1>
    <p class="reveal" style="max-width:34rem">Articles, notes, and things I'm figuring out.</p>

    <div class="list reveal">
      {posts.length === 0 && <p class="muted">No posts yet — check back soon.</p>}
      {posts.map((post) => (
        <a class="card post" href={`/blog/${post.id}`}>
          <span class="muted">{fmt(post.data.date)}</span>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-title { font-size: clamp(2.5rem, 8vw, 4.5rem); margin: 1rem 0; }
  .list { display: flex; flex-direction: column; gap: 1rem; margin-top: 2.5rem; }
  .post {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: center;
    gap: 1.5rem;
  }
  .post h3 { margin-bottom: 0.35rem; }
  .post p { margin: 0; font-size: 0.95rem; }
  .post .arrow { color: var(--accent); font-size: 1.3rem; }
  @media (max-width: 640px) {
    .post { grid-template-columns: 1fr; gap: 0.5rem; }
    .post .arrow { display: none; }
  }
</style>
