---
import Base from '../layouts/Base.astro';
import { site, about, skills, projects, socials } from '../config';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero wrap">
    <div class="badge reveal">
      <span class="dot"></span> Available for work
    </div>
    <h1 class="reveal">
      <span class="line">Hi, I'm</span>
      <span class="name gradient-text">{site.name}</span>
    </h1>
    <p class="role reveal">{site.role}</p>
    <p class="tagline reveal">{site.tagline}</p>
    <div class="actions reveal">
      <a href="/#work" class="btn btn-primary">View my work →</a>
      <a href={`mailto:${site.email}`} class="btn btn-ghost">Get in touch</a>
    </div>
    <div class="socials reveal">
      {socials.map((s) => (
        <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
      ))}
    </div>
    <div class="scroll-hint" aria-hidden="true">scroll ↓</div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="section wrap reveal">
    <span class="label">01 — About</span>
    <div class="about-grid">
      <div>
        {about.map((para) => <p class="about-p">{para}</p>)}
      </div>
      <div class="skills-box">
        <p class="muted" style="margin-bottom:1rem">Toolkit</p>
        <ul class="tags">
          {skills.map((skill) => <li class="tag">{skill}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section id="work" class="section wrap reveal">
    <span class="label">02 — Selected work</span>
    <div class="bento">
      {projects.map((p, i) => (
        <a
          class:list={['card', 'project', { featured: i === 0 }]}
          href={p.link}
          target="_blank"
          rel="noopener"
        >
          <div class="project-top">
            <h3>{p.title}</h3>
            <span class="arrow">↗</span>
          </div>
          <p>{p.description}</p>
          <div class="project-foot">
            <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
            {p.source && <span class="muted src">source</span>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  {posts.length > 0 && (
    <section id="writing" class="section wrap reveal">
      <span class="label">03 — Writing</span>
      <div class="posts">
        {posts.map((post) => (
          <a class="card post" href={`/blog/${post.id}`}>
            <span class="muted">{fmt(post.data.date)}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="read">Read article <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
      <p style="margin-top:2rem"><a href="/blog" class="all">All articles →</a></p>
    </section>
  )}
</Base>

<style>
  /* hero */
  .hero {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 4rem;
    position: relative;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-soft);
    background: var(--card);
    border: 1px solid var(--border);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    margin-bottom: 1.75rem;
  }
  .dot {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(52,211,153,0.5); }
    70% { box-shadow: 0 0 0 8px rgba(52,211,153,0); }
    100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); }
  }
  h1 { display: flex; flex-direction: column; gap: 0.2rem; }
  .line { font-size: clamp(1.1rem, 3vw, 1.6rem); font-weight: 400; color: var(--text-soft); letter-spacing: -0.01em; }
  .name { font-size: clamp(3rem, 11vw, 7rem); font-weight: 700; }
  .role { font-family: var(--font-mono); font-size: clamp(1rem, 2.5vw, 1.3rem); color: var(--text); margin-top: 1.25rem; }
  .tagline { font-size: clamp(1.05rem, 2vw, 1.25rem); max-width: 40rem; margin-top: 1rem; }
  .actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2.25rem; }
  .socials { display: flex; gap: 1.5rem; margin-top: 2.5rem; }
  .socials a { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-soft); }
  .socials a:hover { color: var(--text); }
  .scroll-hint {
    position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim);
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob { 0%,100% { transform: translate(-50%,0); } 50% { transform: translate(-50%,6px); } }

  /* about */
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; }
  .about-p { font-size: 1.15rem; color: var(--text-soft); }
  .about-p + .about-p { margin-top: 1rem; }
  .skills-box {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 20px; padding: 1.75rem; backdrop-filter: blur(14px);
    align-self: start;
  }

  /* bento work grid */
  .bento { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .project { display: flex; flex-direction: column; min-height: 220px; }
  .project.featured { grid-column: span 2; min-height: 260px; }
  .project-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .project .arrow { color: var(--accent); font-size: 1.2rem; }
  .project p { margin-top: 0.5rem; flex: 1; }
  .project-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.25rem; }
  .src { flex-shrink: 0; }

  /* writing */
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .post { display: flex; flex-direction: column; gap: 0.6rem; }
  .post h3 { margin: 0.2rem 0; }
  .post p { flex: 1; }
  .read { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); }
  .all { font-family: var(--font-mono); font-size: 0.95rem; }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .bento { grid-template-columns: 1fr; }
    .project.featured { grid-column: span 1; }
    .posts { grid-template-columns: 1fr; }
  }
</style>
