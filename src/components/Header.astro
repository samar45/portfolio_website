---
import { site } from '../config';
const initials = site.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<header class="site-header">
  <nav class="wrap inner">
    <a href="/" class="brand">
      <span class="mark">{initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="links">
      <a href="/#work">Work</a>
      <a href="/blog">Blog</a>
      <a href={`mailto:${site.email}`} class="cta">Contact</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    padding: 0 0.75rem;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    backdrop-filter: blur(16px) saturate(160%);
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--text); }
  .brand:hover { color: var(--text); }
  .mark {
    display: grid;
    place-items: center;
    width: 2rem; height: 2rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: #0a0a0f;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
  }
  .brand-name { font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; }
  .links { display: flex; align-items: center; gap: 0.35rem; }
  .links a {
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    transition: color 0.2s, background 0.2s;
  }
  .links a:hover { color: var(--text); background: var(--card-hover); }
  .links .cta {
    color: var(--text);
    border: 1px solid var(--border-strong);
  }
  .links .cta:hover { border-color: var(--accent); }
  @media (max-width: 480px) {
    .brand-name { display: none; }
  }
</style>
