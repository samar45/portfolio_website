---
import { site, socials } from '../config';
---

<footer class="site-footer">
  <div class="wrap inner">
    <div>
      <p class="big">Let's build something.</p>
      <a href={`mailto:${site.email}`} class="email">{site.email}</a>
    </div>
    <div class="right">
      <ul class="links">
        {socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.label} ↗</a></li>
        ))}
      </ul>
      <p class="muted">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: 4rem; padding: 3.5rem 0 2.5rem; }
  .inner { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .big { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); color: var(--text); letter-spacing: -0.02em; margin-bottom: 0.5rem; }
  .email { font-family: var(--font-mono); font-size: 0.95rem; }
  .right { text-align: right; display: flex; flex-direction: column; gap: 1rem; }
  .links { display: flex; gap: 1.25rem; list-style: none; justify-content: flex-end; flex-wrap: wrap; }
  .links a { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-soft); }
  .links a:hover { color: var(--text); }
  @media (max-width: 560px) { .right { text-align: left; } .links { justify-content: flex-start; } }
</style>
